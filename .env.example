# URL base a auditar (requerido por el spec accesibilidad-sitemap)
SITE_URL="https://www.ejemplo.com"

# Si publicas los artifacts (S3/Netlify/Pages/CDN) y quieres enlaces HTTP en el informe:
# Debe apuntar al nivel que contiene /auditorias
# Ejemplo: https://cdn.miempresa.com/a11y-artifacts
PUBLIC_BASE_URL=""

# Formato de salida del informe:
# - excel  -> separador ; y HYPERLINK estilo Excel
# - sheets -> separador , y HYPERLINK estilo Google Sheets
# - tsv    -> tabulador (si lo combinas con LINK_MODE=plain verás URLs tal cual)
CSV_MODE="excel"

# Cómo renderizar los enlaces en el CSV: formula | plain
LINK_MODE="formula"

# Subcarpeta del spec donde Cypress guarda screenshots (no toques si sigues el layout sugerido)
SPEC_SUBDIR="accesibilidad-sitemap.cy.js"

# (Opcional) Fijar nombre de carpeta de auditoría.
# Si lo dejas vacío, se autogenera: <DD-MM-AAAA>-<host>
# AUDIT_DIR_NAME="2025-10-24-www.ejemplo.com"

