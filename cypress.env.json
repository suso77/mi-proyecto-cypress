{
  "A11Y": {
    "cookieBannerSelector": "[id*='cookie' i],[class*='cookie' i],[role='dialog']",
    "cookieAcceptSelector": "button:contains('Aceptar'), button:contains('Accept'), [aria-label*='accept' i], [data-accept]",
    "sameOriginIframes": [
      { "iframe": "iframe[src*='maps-interno']", "inner": "body" },
      { "iframe": "iframe#catalogo", "inner": "main" }
    ],
    "crossOriginIframes": [
      "iframe[src*='youtube.com']",
      "iframe[src*='vimeo.com']"
    ]
  }
}



